# ---- Order mode ----
# "mock" works with no external services (default in development).
# "live" forwards orders to your viaSocket webhook.
ORDER_MODE=mock

# ---- viaSocket (server-side only, never prefix with NEXT_PUBLIC_) ----
# PLACEHOLDER: paste the webhook URL from your viaSocket flow once it exists.
VIASOCKET_WEBHOOK_URL=
# PLACEHOLDER: only if your flow requires an auth header. Name/format come from viaSocket.
VIASOCKET_AUTH_HEADER_NAME=
VIASOCKET_AUTH_HEADER_VALUE=

# ---- Razorpay ----
# Secret configured on the Razorpay webhook. Used only to verify X-Razorpay-Signature.
RAZORPAY_WEBHOOK_SECRET=

# ---- Public site config ----
# Bakery WhatsApp number, digits only with country code (no +). Leave empty until supplied.
NEXT_PUBLIC_WHATSAPP_NUMBER=919301748255
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/kora_bakehouse/

# ---- viaSocket (org/project/embed secret) ----
VIASOCKET_ORG_ID=66403
VIASOCKET_PROJECT_ID=projc0M9xUab
# Secret: set in Embarko App setup, not committed.
VIASOCKET_EMBED_SECRET=
